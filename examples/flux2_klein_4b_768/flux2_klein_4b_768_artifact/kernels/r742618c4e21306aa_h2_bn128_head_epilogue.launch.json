 "header": "inline void nr_apply(float4 x, float4 w, float2 cs, float2 sn, device bfloat16_t* dst) {\n  float ss = x.x * x.x + x.y * x.y + x.z * x.z + x.w * x.w;\n  ss = metal::simd_sum(ss);\n  float inv = metal::precise::rsqrt(ss / 128.0f + 1e-5f);\n  float y0 = float(static_cast<bfloat16_t>(w.x * (x.x * inv)));\n  float y1 = float(static_cast<bfloat16_t>(w.y * (x.y * inv)));\n  float y2 = float(static_cast<bfloat16_t>(w.z * (x.z * inv)));\n  float y3 = float(static_cast<bfloat16_t>(w.w * (x.w * inv)));\n  float r0 = y0 * cs.x + (-y1) * sn.x;\n  float r1 = y1 * cs.x + y0 * sn.x;\n  float r2 = y2 * cs.y + (-y3) * sn.y;\n  float r3 = y3 * cs.y + y2 * sn.y;\n  dst[0] = static_cast<bfloat16_t>(r0);\n  dst[1] = static_cast<bfloat16_t>(r1);\n  dst[2] = static_cast<bfloat16_t>(r2);\n  dst[3] = static_cast<bfloat16_t>(r3);\n}\n",
